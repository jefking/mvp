{
  "name": "@jefking/api-blob-storage",
  "version": "0.1.0",
  "description": "Express-compatible JSON resource middleware backed by S3-compatible object storage",
  "license": "MIT",
  "author": "Jef King",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jefking/mvp.git"
  },
  "bugs": {
    "url": "https://github.com/jefking/mvp/issues"
  },
  "homepage": "https://github.com/jefking/mvp#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./sample": "./dapr-app/sample.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dapr-app/sample.json"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test test/unit/*.test.js dapr-app/validation/app.test.js dapr-app/writer/app.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "express",
    "middleware",
    "s3",
    "minio",
    "dapr",
    "object-storage"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0"
  },
  "devDependencies": {
    "@testcontainers/minio": "^12.1.0",
    "axios": "^1.18.0",
    "express": "^5.2.1",
    "openapi-backend": "^5.17.0"
  }
}
